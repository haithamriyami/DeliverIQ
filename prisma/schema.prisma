generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecipientStatus {
  active
  bounced
  unsubscribed
}

enum CampaignStatus {
  pending
  sending
  completed
}

enum CampaignRecipientStatus {
  sent
  bounced
  opened
  clicked
}

enum UserRole {
  owner
  member
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users      User[]
  invites    Invite[]
  members    WorkspaceMember[]
  recipients Recipient[]
  lists      ContactList[]
  templates  Template[]
  campaigns  Campaign[]

  gmailEmail        String?   @map("gmail_email")
  gmailRefreshToken String?   @map("gmail_refresh_token")
  gmailConnectedAt  DateTime? @map("gmail_connected_at")
  fromDisplayName   String?   @map("from_display_name")
  replyToEmail      String?   @map("reply_to_email")
  sendGapSeconds    Int       @default(10) @map("send_gap_seconds")
  sendJitterSeconds Int       @default(5) @map("send_jitter_seconds")
  dailySendCap      Int       @default(200) @map("daily_send_cap")
  // Global kill switch: while set, nothing is sent from any account in this workspace.
  sendingPausedAt     DateTime? @map("sending_paused_at")
  sendingPausedReason String    @default("") @map("sending_paused_reason")

  @@map("workspaces")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  // Role in the default workspace. The real role is per workspace in workspace_members.
  role         UserRole @default(member)
  // Default (last used) workspace. Which workspace a session works in is in the login token.
  workspaceId  String   @map("workspace_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Old per user Gmail columns. No longer read or written: Gmail is per workspace in
  // gmail_accounts and workspace_members.gmail_account_id. Kept so a rollback still works.
  gmailEmail        String?   @map("gmail_email")
  gmailRefreshToken String?   @map("gmail_refresh_token")
  gmailConnectedAt  DateTime? @map("gmail_connected_at")

  // Old per sender throttle state (see above, no longer used). nextSendAt is claimed atomically before every send.
  nextSendAt           DateTime? @map("next_send_at")
  lastSentAt           DateTime? @map("last_sent_at")
  sendingPausedAt      DateTime? @map("sending_paused_at")
  sendingPausedReason  String    @default("") @map("sending_paused_reason")
  lastInboxSyncAt      DateTime? @map("last_inbox_sync_at")
  // Inbox sync (bounces + replies): incremental cursor, throttle, lease and quota backoff.
  gmailHistoryId       String?   @map("gmail_history_id")
  inboxSyncNotBefore   DateTime? @map("inbox_sync_not_before")
  inboxSyncLeaseUntil  DateTime? @map("inbox_sync_lease_until")
  inboxSyncErrors      Int       @default(0) @map("inbox_sync_errors")
  inboxSyncNotice      String    @default("") @map("inbox_sync_notice")
  // Short send backoff after a per minute Gmail quota error (never a pause).
  sendBackoffCount     Int       @default(0) @map("send_backoff_count")

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships WorkspaceMember[]
  campaigns   Campaign[]
  sends       CampaignRecipient[]
  replies     InboundReply[]

  @@map("users")
}

/// One connected Gmail address. Workspace members link to it to send from it. The send gap,
/// daily count, pauses and inbox sync live here, so they stay shared by every workspace
/// that uses the same Gmail address.
model GmailAccount {
  id            String    @id @default(uuid())
  email         String    @unique
  refreshToken  String?   @map("refresh_token")
  connectedAt   DateTime? @map("connected_at")
  // Who first connected it. Only used to count sends recorded before sender_account_id existed.
  connectedById String?   @map("connected_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  nextSendAt          DateTime? @map("next_send_at")
  lastSentAt          DateTime? @map("last_sent_at")
  sendingPausedAt     DateTime? @map("sending_paused_at")
  sendingPausedReason String    @default("") @map("sending_paused_reason")
  sendBackoffCount    Int       @default(0) @map("send_backoff_count")
  lastInboxSyncAt     DateTime? @map("last_inbox_sync_at")
  gmailHistoryId      String?   @map("gmail_history_id")
  inboxSyncNotBefore  DateTime? @map("inbox_sync_not_before")
  inboxSyncLeaseUntil DateTime? @map("inbox_sync_lease_until")
  inboxSyncErrors     Int       @default(0) @map("inbox_sync_errors")
  inboxSyncNotice     String    @default("") @map("inbox_sync_notice")

  members WorkspaceMember[]
  sends   CampaignRecipient[]
  replies InboundReply[]

  @@map("gmail_accounts")
}

/// A user can belong to many workspaces, with a role in each.
model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        UserRole @default(member)
  createdAt   DateTime @default(now()) @map("created_at")
  // The Gmail this member sends from in this workspace. Each workspace has its own.
  gmailAccountId String? @map("gmail_account_id")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailAccount GmailAccount? @relation(fields: [gmailAccountId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([gmailAccountId])
  @@index([userId])
  @@map("workspace_members")
}

model Invite {
  id          String    @id @default(uuid())
  email       String
  token       String    @unique
  role        UserRole  @default(member)
  workspaceId String    @map("workspace_id")
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("invites")
}

model Recipient {
  id                 String          @id @default(uuid())
  workspaceId        String          @map("workspace_id")
  email              String
  name               String
  organization       String?
  status             RecipientStatus @default(active)
  timezone           String          @default("UTC")
  notes              String          @default("")
  lastError          String          @default("") @map("last_error")
  doNotContact       Boolean         @default(false) @map("do_not_contact")
  repliedAt          DateTime?       @map("replied_at")
  unsubscribeToken   String          @unique @default(uuid()) @map("unsubscribe_token")
  listId             String          @map("list_id")
  createdAt          DateTime        @default(now()) @map("created_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  list               ContactList         @relation(fields: [listId], references: [id], onDelete: Restrict)
  campaignRecipients CampaignRecipient[]
  replies            InboundReply[]

  @@unique([workspaceId, email])
  @@index([listId])
  @@map("recipients")
}

model ContactList {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  createdAt   DateTime @default(now()) @map("created_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  recipients Recipient[]
  campaigns  Campaign[]

  @@unique([workspaceId, name])

  @@map("contact_lists")
}

model Template {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  body        String
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  campaigns Campaign[]
  steps     CampaignStep[]

  @@index([workspaceId])

  @@map("templates")
}

model Campaign {
  id           String         @id @default(uuid())
  workspaceId  String         @map("workspace_id")
  name         String
  subject      String
  templateId   String         @map("template_id")
  scheduledAt  DateTime       @map("scheduled_at")
  status       CampaignStatus @default(pending)
  recipientIds String[]       @default([]) @map("recipient_ids")
  notes        String         @default("")
  listId       String?        @map("list_id")
  createdById  String?        @map("created_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  pausedAt     DateTime?      @map("paused_at")
  pausedReason String         @default("") @map("paused_reason")

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  template           Template             @relation(fields: [templateId], references: [id])
  replies            InboundReply[]
  createdBy          User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  list               ContactList?         @relation(fields: [listId], references: [id], onDelete: SetNull)
  steps              CampaignStep[]
  campaignRecipients CampaignRecipient[]

  @@index([workspaceId])
  @@map("campaigns")
}

model CampaignStep {
  id           String         @id @default(uuid())
  campaignId   String         @map("campaign_id")
  stepNumber   Int            @map("step_number")
  name         String
  subject      String
  templateId   String         @map("template_id")
  status       CampaignStatus @default(pending)
  recipientIds String[]       @default([]) @map("recipient_ids")
  createdAt    DateTime       @default(now()) @map("created_at")

  campaign           Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template           Template             @relation(fields: [templateId], references: [id])
  campaignRecipients CampaignRecipient[]

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
  @@map("campaign_steps")
}

model CampaignRecipient {
  id          String                   @id @default(uuid())
  campaignId  String                   @map("campaign_id")
  stepId      String                   @map("step_id")
  recipientId String                   @map("recipient_id")
  status      CampaignRecipientStatus
  error       String                   @default("")
  sentAt      DateTime?                @map("sent_at")
  messageId   String?                  @map("message_id")
  threadId    String?                  @map("thread_id")
  senderId    String?                  @map("sender_id")
  // The Gmail address it went out from. The daily cap counts these.
  senderAccountId String?              @map("sender_account_id")

  sender        User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderAccount GmailAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  campaign  Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  step      CampaignStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  recipient Recipient    @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([stepId, recipientId])
  @@index([campaignId, status])
  @@index([stepId, status])
  @@index([senderId, sentAt])
  @@index([senderAccountId, sentAt])
  @@map("campaign_recipients")
}

enum InboundReplyType {
  reply
  auto_reply
  opt_out
}

model InboundReply {
  id             String           @id @default(uuid())
  gmailMessageId String           @unique @map("gmail_message_id")
  threadId       String?          @map("thread_id")
  type           InboundReplyType
  senderId       String?          @map("sender_id")
  senderAccountId String?         @map("sender_account_id")
  recipientId    String           @map("recipient_id")
  campaignId     String?          @map("campaign_id")
  subject        String           @default("")
  snippet        String           @default("")
  receivedAt     DateTime         @default(now()) @map("received_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  sender        User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderAccount GmailAccount? @relation(fields: [senderAccountId], references: [id], onDelete: SetNull)
  recipient     Recipient     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  campaign      Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId, type])
  @@index([recipientId])
  @@map("inbound_replies")
}

/// One long running background sender at a time. Overlap is still safe because every
/// send claims users.next_send_at atomically; the lease just avoids idle duplicate runs.
model SchedulerLease {
  name      String   @id
  holder    String
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("scheduler_leases")
}
