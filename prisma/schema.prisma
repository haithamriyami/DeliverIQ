generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecipientStatus {
  active
  bounced
  unsubscribed
}

enum CampaignStatus {
  pending
  sending
  completed
}

enum CampaignRecipientStatus {
  sent
  bounced
  opened
  clicked
}

enum UserRole {
  owner
  member
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  users   User[]
  invites Invite[]

  gmailEmail        String?   @map("gmail_email")
  gmailRefreshToken String?   @map("gmail_refresh_token")
  gmailConnectedAt  DateTime? @map("gmail_connected_at")
  fromDisplayName   String?   @map("from_display_name")
  replyToEmail      String?   @map("reply_to_email")
  sendGapSeconds    Int       @default(30) @map("send_gap_seconds")
  sendJitterSeconds Int       @default(10) @map("send_jitter_seconds")
  dailySendCap      Int       @default(200) @map("daily_send_cap")

  @@map("workspaces")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         UserRole @default(member)
  workspaceId  String   @map("workspace_id")
  createdAt    DateTime @default(now()) @map("created_at")

  gmailEmail        String?   @map("gmail_email")
  gmailRefreshToken String?   @map("gmail_refresh_token")
  gmailConnectedAt  DateTime? @map("gmail_connected_at")

  // Per sender throttle state. nextSendAt is claimed atomically before every send.
  nextSendAt           DateTime? @map("next_send_at")
  lastSentAt           DateTime? @map("last_sent_at")
  sendingPausedAt      DateTime? @map("sending_paused_at")
  sendingPausedReason  String    @default("") @map("sending_paused_reason")
  lastInboxSyncAt      DateTime? @map("last_inbox_sync_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  sends     CampaignRecipient[]
  replies   InboundReply[]

  @@map("users")
}

model Invite {
  id          String    @id @default(uuid())
  email       String
  token       String    @unique
  role        UserRole  @default(member)
  workspaceId String    @map("workspace_id")
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("invites")
}

model Recipient {
  id                 String          @id @default(uuid())
  email              String          @unique
  name               String
  status             RecipientStatus @default(active)
  timezone           String          @default("UTC")
  notes              String          @default("")
  lastError          String          @default("") @map("last_error")
  doNotContact       Boolean         @default(false) @map("do_not_contact")
  repliedAt          DateTime?       @map("replied_at")
  unsubscribeToken   String          @unique @default(uuid()) @map("unsubscribe_token")
  listId             String          @map("list_id")
  createdAt          DateTime        @default(now()) @map("created_at")

  list               ContactList         @relation(fields: [listId], references: [id], onDelete: Restrict)
  campaignRecipients CampaignRecipient[]
  replies            InboundReply[]

  @@index([listId])
  @@map("recipients")
}

model ContactList {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  recipients Recipient[]
  campaigns  Campaign[]

  @@map("contact_lists")
}

model Template {
  id        String   @id @default(uuid())
  name      String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  campaigns Campaign[]
  steps     CampaignStep[]

  @@map("templates")
}

model Campaign {
  id           String         @id @default(uuid())
  name         String
  subject      String
  templateId   String         @map("template_id")
  scheduledAt  DateTime       @map("scheduled_at")
  status       CampaignStatus @default(pending)
  recipientIds String[]       @default([]) @map("recipient_ids")
  notes        String         @default("")
  listId       String?        @map("list_id")
  createdById  String?        @map("created_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  pausedAt     DateTime?      @map("paused_at")
  pausedReason String         @default("") @map("paused_reason")

  template           Template             @relation(fields: [templateId], references: [id])
  replies            InboundReply[]
  createdBy          User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  list               ContactList?         @relation(fields: [listId], references: [id], onDelete: SetNull)
  steps              CampaignStep[]
  campaignRecipients CampaignRecipient[]

  @@map("campaigns")
}

model CampaignStep {
  id           String         @id @default(uuid())
  campaignId   String         @map("campaign_id")
  stepNumber   Int            @map("step_number")
  name         String
  subject      String
  templateId   String         @map("template_id")
  status       CampaignStatus @default(pending)
  recipientIds String[]       @default([]) @map("recipient_ids")
  createdAt    DateTime       @default(now()) @map("created_at")

  campaign           Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template           Template             @relation(fields: [templateId], references: [id])
  campaignRecipients CampaignRecipient[]

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
  @@map("campaign_steps")
}

model CampaignRecipient {
  id          String                   @id @default(uuid())
  campaignId  String                   @map("campaign_id")
  stepId      String                   @map("step_id")
  recipientId String                   @map("recipient_id")
  status      CampaignRecipientStatus
  error       String                   @default("")
  sentAt      DateTime?                @map("sent_at")
  messageId   String?                  @map("message_id")
  threadId    String?                  @map("thread_id")
  senderId    String?                  @map("sender_id")

  sender    User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  campaign  Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  step      CampaignStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  recipient Recipient    @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([stepId, recipientId])
  @@index([campaignId, status])
  @@index([stepId, status])
  @@index([senderId, sentAt])
  @@map("campaign_recipients")
}

enum InboundReplyType {
  reply
  auto_reply
  opt_out
}

model InboundReply {
  id             String           @id @default(uuid())
  gmailMessageId String           @unique @map("gmail_message_id")
  threadId       String?          @map("thread_id")
  type           InboundReplyType
  senderId       String?          @map("sender_id")
  recipientId    String           @map("recipient_id")
  campaignId     String?          @map("campaign_id")
  subject        String           @default("")
  snippet        String           @default("")
  receivedAt     DateTime         @default(now()) @map("received_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  sender    User?     @relation(fields: [senderId], references: [id], onDelete: SetNull)
  recipient Recipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId, type])
  @@index([recipientId])
  @@map("inbound_replies")
}
