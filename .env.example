PORT=3000
NODE_ENV=development
APP_URL=http://127.0.0.1:3000
SESSION_SECRET=change-me-in-production

DATABASE_URL=postgresql://deliveriq:deliveriq@127.0.0.1:5433/deliveriq?schema=public
# Neon also injects DATABASE_URL_UNPOOLED. Local Docker can reuse DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://deliveriq:deliveriq@127.0.0.1:5433/deliveriq?schema=public

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://default:password@host:6379
# Use REDIS_URL in production (Render / Railway / Upstash). It overrides the host fields.

SENDGRID_API_KEY=placeholder-sendgrid-api-key
SENDGRID_FROM_EMAIL=hello@deliveriq.local
SENDGRID_FROM_NAME=DeliverIQ
SENDGRID_WEBHOOK_VERIFICATION_KEY=
SENDGRID_DRY_RUN=true

# Free Gmail sending — no custom domain required
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI is APP_URL + /auth/google/callback. Add that exact value in Google Cloud.
